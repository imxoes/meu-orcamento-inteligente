{
  "framework": "nextjs",
  "functions": {
    "src/app/api/**/*": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "buildCommand": "prisma generate && next build",
  "installCommand": "npm install",
  "//": "Auditoria completa - Projeto limpo e otimizado"
}